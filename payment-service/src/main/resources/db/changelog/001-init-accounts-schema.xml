<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="create_accounts_sequence" author="alexlakers">
        <preConditions>
            <not>
                <sequenceExists sequenceName="accounts_sequence"/>
            </not>
        </preConditions>
        <createSequence sequenceName="accounts_sequence" incrementBy="1"/>
        <rollback>
            <dropSequence sequenceName="accounts_sequence"/>
        </rollback>
    </changeSet>

    <changeSet id="create_accounts_table" author="alexlakers">

        <preConditions>
            <not>
                <tableExists tableName="accounts"/>
            </not>
        </preConditions>

        <createTable tableName="accounts">
            <column name="id" type="bigint" defaultValueSequenceNext="accounts_sequence">
                <constraints primaryKey="true"/>
            </column>
            <column name="balance" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <rollback>
            <dropTable tableName="accounts"/>
        </rollback>
    </changeSet>

</databaseChangeLog>