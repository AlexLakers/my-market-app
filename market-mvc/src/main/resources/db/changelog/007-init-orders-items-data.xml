<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">
    <changeSet id="insert_orders_items_data" author="alexlakers">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="orders_items"/>
            <sqlCheck expectedResult="0">SELECT COUNT(*)
                                         FROM orders_items</sqlCheck>
        </preConditions>
        <insert tableName="orders_items">
            <column name="item_id" valueNumeric="1"/>
            <column name="order_id" valueNumeric="1"/>
            <column name="history_price" valueNumeric="2000"/>
            <column name="count" valueNumeric="2"/>
        </insert>
        <insert tableName="orders_items">
            <column name="item_id" valueNumeric="2"/>
            <column name="order_id" valueNumeric="2"/>
            <column name="history_price" valueNumeric="2000"/>
            <column name="count" valueNumeric="2"/>
        </insert>
        <insert tableName="orders_items">
            <column name="item_id" valueNumeric="3"/>
            <column name="order_id" valueNumeric="3"/>
            <column name="history_price" valueNumeric="2000"/>
            <column name="count" valueNumeric="2"/>
        </insert>

        <rollback>
            <delete tableName="orders_items">
                <where>id IN (1,2,3)</where>
            </delete>
        </rollback>
    </changeSet>

</databaseChangeLog>