<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">
    <changeSet id="insert_orders_data" author="alexlakers">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="orders"/>
            <sqlCheck expectedResult="0">SELECT COUNT(*)
                                         FROM orders</sqlCheck>
        </preConditions>
        <insert tableName="orders">
            <column name="total_sum" valueNumeric="1000"/>
            <column name="status" value="PAID"/>
            <column name="user_id" valueNumeric="1"/>
        </insert>
        <insert tableName="orders">
            <column name="total_sum" valueNumeric="100000"/>
            <column name="status" value="PAID"/>
            <column name="user_id" valueNumeric="1"/>
        </insert>
        <insert tableName="orders">
            <column name="total_sum" valueNumeric="20000"/>
            <column name="status" value="PAID"/>
            <column name="user_id" valueNumeric="1"/>
        </insert>

        <rollback>
            <delete tableName="orders">
                <where>total_sum IN (1000,100000,20000)</where>
            </delete>
        </rollback>
    </changeSet>

</databaseChangeLog>